        ]
    ]
//- Двошарове посилання: фронтовий (темний) та наведений (синій) шар,
//- як у старому меню — на hover текст «перегортається» на синю копію.
mixin menuV2Link(link)
    a.menu-v2__link(href=link.href data-menu-v2-close=link.close)
        span.menu-v2__link-line!= link.title
        span.menu-v2__link-line.menu-v2__link-line--hover(aria-hidden="true")!= link.title
nav.menu-v2(data-menu-v2 data-lenis-prevent aria-hidden="true")
    .menu-v2__noise
    .menu-v2__inner
        .menu-v2__main
            .menu-v2__nav.menu-v2__nav--primary
                each col in menuV2Primary
                    .menu-v2__col
                        each link in col
                            +menuV2Link(link)
            .menu-v2__divider
            .menu-v2__nav.menu-v2__nav--secondary
                each col in menuV2Secondary
                    .menu-v2__col
                        each link in col
                            +menuV2Link(link)
        aside.menu-v2__aside
            .menu-v2__image
                img(src="./assets/images/menu/bg.jpg" alt="RiverVille" loading="lazy")
            .menu-v2__contacts
                .menu-v2__contacts-group
                    .menu-v2__contacts-label Відділ інвестицій:
                    a.menu-v2__contacts-value(href="tel:+380992777077") 38 099 277 70 77
                .menu-v2__contacts-group
                    .menu-v2__contacts-label E-mail:
