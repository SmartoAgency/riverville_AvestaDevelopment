
extends ../layout/main
block variable
  -
    var title_page = 'apartments'
    var id_page = 'id-page-apartments'
    var class_page = 'class-page-apartments'
    var breadcrumbsSubitem = [
      {
        label: 'About',
        link: pagesLink[0].about
      }
    ]
  
block meta
  title= title_page
  meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
  script(defer src='./assets/scripts/vendors.bundle.js')
  script(defer src='./assets/scripts/index.bundle.js')
  script(defer src='./assets/scripts/libs.js')
  script(defer src='./assets/scripts/index.js')
  script(defer src='./assets/scripts/header.js')
  script(defer src='./assets/scripts/apartments.bundle.js')
block content
  .inner-page-head
    include ../includes/breadcrumbs.pug
    <svg class="inner-page-head__decor" preserveAspectRatio="xMidYMid slice" width="1920" height="141" viewBox="0 0 1920 141" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M72.687 54.116L158.67 140.881L245.097 54.116L331.08 140.881L417.507 54.116L480 117.177V63.508L417.507 0L331.08 87.2117L245.097 0L158.67 87.2117L72.687 0L0 73.3473V127.463L72.687 54.116Z" fill="white"/>
      <path d="M887.313 54.116L801.33 140.881L714.903 54.116L628.92 140.881L542.493 54.116L480 117.177V63.508L542.493 0L628.92 87.2117L714.903 0L801.33 87.2117L887.313 0L960 73.3473V127.463L887.313 54.116Z" fill="white"/>
      <path d="M1032.69 54.116L1118.67 140.881L1205.1 54.116L1291.08 140.881L1377.51 54.116L1440 117.177V63.508L1377.51 0L1291.08 87.2117L1205.1 0L1118.67 87.2117L1032.69 0L960 73.3473V127.463L1032.69 54.116Z" fill="white"/>
      <path d="M1847.31 54.116L1761.33 140.881L1674.9 54.116L1588.92 140.881L1502.49 54.116L1440 117.177V63.508L1502.49 0L1588.92 87.2117L1674.9 0L1761.33 87.2117L1847.31 0L1920 73.3473V127.463L1847.31 54.116Z" fill="white"/>
    </svg>
    .inner-page-head__title Квартири
  .flats(data-flats-page)
    .flats__container
      .flats-nav
        .flats-nav__body(data-tabs) 
          a.flats-nav__tab(href="http://localhost:3000/apartments", data-tab='apartments') 
            span Всі
          a.flats-nav__tab(href="http://localhost:3000/apartments/1-rooms/", data-tab='1-rooms') 
            span 1 - кімнатні
          a.flats-nav__tab(href="http://localhost:3000/apartments/2-rooms/", data-tab='2-rooms') 
            span 2 - кімнатні
          a.flats-nav__tab(href="http://localhost:3000/apartments/3-rooms/", data-tab='3-rooms') 
            span 3 - кімнатні
          a.flats-nav__tab.flats-nav__tab--commercial(href="http://localhost:3000/apartments/commercial/", data-tab="commercial") 
            span Комерція
          .flats-nav__active-bg(data-tab-bg)
        a.flats-nav__3d 
          .flats-nav__3d-text Генплан
          .flats-nav__3d-icon 
            <svg width="26" height="22" viewBox="0 0 26 22" fill="none">
              <path d="M14.8988 1.4707L24.2203 11.0001M24.2203 11.0001L14.8988 20.5295M24.2203 11.0001C18.6965 11.0001 6.47502 11.0001 1.77979 11.0001" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
      .flats__body(data-flats-body) 
        .flats__list(data-flats-list)
        div(data-load-more-flats)
    .flats-recommendation
      .flats__container.flats-recommendation__title.text-style-1920-h-1 Рекомендовані квартири
      .flats-recommendation__list.swiper(data-swiper-container)
        .swiper-wrapper(data-flats-recommendation-list) 
        .flats-recommendation__nav
          button.flats-recommendation__nav-prev(data-prev-slide)
            <svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M24.3083 29.9999L30.2296 36.3159L28.7705 37.6838L21.2705 29.6838L20.6293 28.9999L21.2705 28.3159L28.7705 20.3159L30.2296 21.6838L24.3083 27.9999H37V29.9999H24.3083Z" fill="#1A1E21"/>
            </svg>
          button.flats-recommendation__nav-next(data-next-slide)
            <svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M33.6917 29.9999L27.7704 36.3159L29.2295 37.6838L36.7295 29.6838L37.3707 28.9999L36.7295 28.3159L29.2295 20.3159L27.7704 21.6838L33.6917 27.9999H21V29.9999H33.6917Z" fill="#1A1E21"/>
            </svg>


  
block footer
  include ../includes/footer.pug

block header
  include ../includes/header.pug
